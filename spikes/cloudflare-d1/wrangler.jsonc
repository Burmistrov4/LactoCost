{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yogurt-d1-spike",
  "main": "src/index.js",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yogurt-d1-spike",
      "database_id": "REPLACE_WITH_REAL_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
